{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ID6 Installer",
  "version": "0.1.0",
  "identifier": "dev.id6apps.installer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "ID6 Installer", "width": 860, "height": 700, "minWidth": 720, "minHeight": 560 }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
